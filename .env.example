# === Prompt Mirror — Environment Variables ===
# Copy this file to .env and fill in your values

# --- Database (Render provides this automatically via Blueprint) ---
DATABASE_URL=postgresql://user:password@localhost:5432/prompt_mirror

# --- JWT Secret (auto-generated by Render Blueprint) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- GitHub OAuth ---
# Create at: https://github.com/settings/applications/new
# Callback URL: https://prompt-mirror-api.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth ---
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: https://prompt-mirror-api.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501
